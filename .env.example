# ==========================================
# CONFIGURAÇÕES DO TELEGRAM BOT
# ==========================================
# Token gerado pelo @BotFather (ex: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=seu_token_do_botfather_aqui
# Seu Chat ID numérico (pode ser descoberto rodando: python3 flight_alert.py --get-chat-id)
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# ==========================================
# PARÂMETROS DA PASSAGEM (EXEMPLO)
# ==========================================
ORIGIN=GRU
DESTINATION=LHR
DEPARTURE_DATE=2027-04-21
RETURN_DATE=2027-04-26
DIRECT_FLIGHT_ONLY=true
TARGET_PRICE=6000.00
CURRENCY=BRL

# ==========================================
# OPÇÕES DE BUSCA E MONITORAMENTO
# ==========================================
# Opções de motor: "fast-flights" (gratuito/scraping direto) ou "serpapi" (API oficial de scraping, 100 buscas grátis/mês)
SEARCH_ENGINE=fast-flights
SERPAPI_KEY=sua_chave_serpapi_opcional

# Intervalo de verificação em minutos (se executado com --loop)
CHECK_INTERVAL_MINUTES=60
